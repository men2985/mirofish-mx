# Frontend de MiroFish compilado para producción (fork MX) servido con nginx.
FROM node:22.21.1-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm ci --prefix frontend
COPY locales ./locales
COPY frontend ./frontend
RUN npm run build --prefix frontend
# Librería 3D para la página pública /p/<token> (servida por nosotros, sin CDN)
RUN mkdir -p frontend/dist/vendor && cp frontend/node_modules/3d-force-graph/dist/3d-force-graph.min.js frontend/dist/vendor/

FROM nginx:1.31.3-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html
EXPOSE 80
